# Copy to backend/.env and fill in the three API keys.
# Loaded by config.py (pydantic-settings); names are case-insensitive.

# --- Required: API keys -------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# --- Optional: everything below has a working default -------------------
# Values shown are the defaults from config.py. Uncomment to override.

# ChromaDB (persistent embedded client). The catalog is not committed —
# build it once with: .venv/bin/python -m services.chromadb_client
# CHROMA_DB_PATH=./data/chroma_db
# CHROMADB_COLLECTION_COURSES=usc_courses
# CHROMADB_COLLECTION_POLICY=usc_policy

# Scheduler/validator loop: max regeneration passes before the best-effort
# plan is returned with unresolved violations surfaced as remarks.
# MAX_VALIDATOR_ITERATIONS=3

# Retry limits for structured-output LLM calls.
# MAX_DESCRIPTION_RETRIES=2
# MAX_RETRIEVAL_RETRIES=2

# Enrichment retrieval tuning.
# MAX_ENRICHMENT_EXPANSION_DEPTH=1
# MIN_ENRICHMENT_COURSES=5

# CORS. Parsed as JSON, so it must be a JSON array — not a bare string.
# CORS_ORIGINS=["http://localhost:3000"]
